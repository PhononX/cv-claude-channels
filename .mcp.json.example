{
  "//": "Only needed if you are running the bare MCP server instead of the plugin. Installing the plugin supplies its own .mcp.json — see README.md. Prefer /carbon-voice:configure over putting CV_PAT here, since .mcp.json usually gets committed.",
  "mcpServers": {
    "cv-claude-channel": {
      "command": "npx",
      "args": ["@carbonvoice/cv-claude-channel"],
      "env": {
        "CV_PAT": "your-personal-access-token-here",
        "CV_CONVERSATION_ID": "",
        "CV_PROJECT_NAME": "",
        "CV_POLL_INTERVAL_MS": "5000",
        "CV_WS_RETRY_MAX_MS": "30000",
        "CV_PERMISSION_TTL_MS": "600000"
      }
    }
  }
}
